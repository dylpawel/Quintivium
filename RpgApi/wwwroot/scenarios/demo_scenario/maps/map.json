lipX":false,"scale":1},{"assetId":"grass_33","x":18,"y":16,"dx":5,"dy":-3,"flipX":true,"scale":1},{"assetId":"pine_trees_7","x":19,"y":16,"dx":-3,"dy":-3,"flipX":true,"scale":1,"_windPhase":45459.63049681467},{"assetId":"pine_trees_2","x":20,"y":16,"dx":-1,"dy":7,"flipX":false,"scale":1,"_windPhase":31054.791143813287},{"assetId":"pine_trees_6","x":21,"y":16,"dx":-8,"dy":-2,"flipX":false,"scale":1,"_windPhase":50219.21046044624},{"assetId":"pine_trees_4","x":25,"y":16,"dx":0,"dy":6,"flipX":true,"scale":1,"_windPhase":84088.09247439119},{"assetId":"pine_trees_8","x":4,"y":17,"dx":9,"dy":3,"flipX":true,"scale":1,"_windPhase":72277.39335077115},{"assetId":"birch_trees_8","x":6,"y":17,"dx":8,"dy":7,"flipX":false,"scale":1,"_windPhase":18906.627735612146},{"assetId":"pine_trees_1","x":7,"y":17,"dx":5,"dy":-1,"flipX":true,"scale":1,"_windPhase":48298.71010202734},{"assetId":"pine_trees_1","x":8,"y":17,"dx":-7,"dy":-2,"flipX":true,"scale":1,"_windPhase":38355.011868077636},{"assetId":"grass_33","x":18,"y":17,"dx":1,"dy":3,"flipX":true,"scale":1},{"assetId":"pine_trees_3","x":24,"y":17,"dx":-5,"dy":10,"flipX":true,"scale":1,"_windPhase":27379.609471846776},{"assetId":"pine_trees_2","x":5,"y":18,"dx":8,"dy":-9,"flipX":true,"scale":1,"_windPhase":51635.910103857466},{"assetId":"pine_trees_6","x":6,"y":18,"dx":9,"dy":8,"flipX":false,"scale":1,"_windPhase":26590.22223759756},{"assetId":"pine_trees_2","x":7,"y":18,"dx":-3,"dy":7,"flipX":true,"scale":1,"_windPhase":96780.65117222031}],"ramps":[],"marks":[],"effects":[{"type":"fire","x":6,"y":5,"dx":0,"dy":3,"scale":0.7,"phase":84713.56966702036}],"hFences":[],"vFences":[],"scripts":[{"id":"intro","on":"scenario_start","once":true,"actions":[{"type":"show_dialog","text":"Welcome, adventurer. Your journey begins here."},{"type":"give_item","item_id":"bread","qty":3}]},{"id":"mage_talk","on":"npc_interact","npc":"mage","actions":[{"type":"show_dialog","speaker":"Hero-Mage","text":"Greetings, traveller. I guard the secrets of these lands."},{"type":"show_choice","text":"What do you seek here?","choices":[{"label":"Nothing. Farewell."},{"label":"Show me your power!","actions":[{"type":"fire_event","event":"mage_power_requested"}]},{"label":"Tell me about these lands.","condition":"stat(mage_skeletons >= 1)","actions":[{"type":"show_dialog","speaker":"Hero-Mage","text":"These lands are ancient. The skeletons you have witnessed are but a shadow of what stirs in the deep."}]}]}]},{"id":"mage_power_exhausted","on":"mage_power_requested","condition":"stat(mage_skeletons >= 3)","actions":[{"type":"show_dialog","speaker":"Hero-Mage","text":"I have exhausted my power. The dead must rest now."}]},{"id":"mage_power_spawn","on":"mage_power_requested","condition":"!stat(mage_skeletons >= 3)","actions":[{"type":"spawn_monster","monster":"Skeleton"},{"type":"add_variable","name":"mage_skeletons","delta":1},{"type":"show_dialog","speaker":"Hero-Mage","text":"Behold! The undead rise at my command. Defeat them if you dare."}]},{"id":"spawn_npcs","on":"map_enter","once":true,"actions":[{"type":"spawn_npc","npc":"Hero-Mage","x":4,"y":18,"id":"mage"},{"type":"spawn_npc","npc":"Hero-Farmer","x":2,"y":5,"id":"farmer"}]},{"id":"spawn_test_items","on":"map_enter","once":true,"actions":[{"type":"spawn_item","item_id":"Gold","x":10,"y":10,"qty":5},{"type":"spawn_item","item_id":"sword","x":12,"y":10},{"type":"spawn_item","item_id":"torch","x":14,"y":10,"qty":2}]},{"id":"map_enter_world","on":"map_enter","once":true,"actions":[{"type":"spawn_monster","monster":"Orc Pounder"},{"type":"spawn_monster","monster":"Skeleton"},{"type":"spawn_monster","monster":"Knight"},{"type":"spawn_monster","monster":"Skeleton Warrior","x":23,"y":4},{"type":"spawn_monster","monster":"Wizard","x":28,"y":15},{"type":"spawn_monster","monster":"Orc Warrior","x":20,"y":10,"radius":3},{"type":"spawn_monster","monster":"Skeleton Mage","x":20,"y":10,"radius":3},{"type":"spawn_monster","monster":"Rogue","x":20,"y":10,"radius":3},{"type":"show_dialog","text":"You stand at the edge of a vast world..."}]},{"id":"cave_enter_notorch","on":"tile_approach","tile":{"x":23,"y":3},"condition":"!has_item(torch)","actions":[{"type":"show_dialog","text":"The cave entrance yawns before you, dark and cold."},{"type":"show_dialog","text":"You need a torch before venturing in there.","item":"torch"},{"type":"block_move"}]},{"id":"cave_enter","on":"tile_approach","tile":{"x":23,"y":3},"condition":"has_item(torch)","actions":[{"type":"show_dialog","text":"Torch in hand, you step into the darkness...","item":"torch"},{"type":"change_map","map_id":"cave","mark":"Start"}]},{"id":"cooper_hut_repeat","on":"tile_approach","tile":{"x":20,"y":10},"condition":"flag(cooper_visited)","actions":[{"type":"show_dialog","text":"The hut is silent now. The Orc Shaman is gone."},{"type":"block_move"}]},{"id":"cooper_hut","on":"tile_approach","tile":{"x":20,"y":10},"once":true,"actions":[{"type":"set_flag","name":"cooper_visited"},{"type":"show_dialog","text":"You see a small hut. It looks abandoned..."},{"type":"show_dialog","text":"Suddenly, an Orc Shaman appears!"},{"type":"start_combat","enemy_id":"Orc Shaman"}]},{"id":"seaside_hut","on":"tile_approach","tile":{"x":25,"y":12},"actions":[{"type":"show_dialog","text":"Something feels strange about this place..."}]},{"id":"armory_hut","on":"tile_approach","tile":{"x":15,"y":14},"actions":[{"type":"show_dialog","text":"I'd better stay outside, it's not a good idea to go in there alone."}]},{"id":"orc_ambush","on":"tile_approach","condition":"near(10, 10, 2) && chance(0.2)","actions":[{"type":"show_dialog","text":"An Orc leaps out from the shadows!"},{"type":"start_combat","enemy_id":"Orc"}]},{"id":"fire_block","on":"tile_approach","tile":{"x":6,"y":5},"actions":[{"type":"show_dialog","text":"The heat is unbearable. Flames leap and roar, barring your path."},{"type":"fire_event","event":"acquire_torch"},{"type":"block_move"}]},{"id":"acquire_torch","on":"acquire_torch","once":true,"actions":[{"type":"show_dialog","text":"You notice a torch nearby, perhaps it could help you navigate the dark caves.","item":"torch"},{"type":"give_item","item_id":"torch"}]},{"id":"mushroom_story","on":"tile_enter","tile":{"x":5,"y":13},"actions":[{"type":"show_dialog","text":"Ah, the air here is thick with the scent of deep earth. These mushrooms hold ancient secrets, whispering tales of the old gods and the forgotten magic that sleeps beneath the roots."}]},{"id":"fallen_oak_story","on":"tile_enter","tile":{"x":8,"y":4},"actions":[{"type":"pick_random","choices":[{"actions":[{"type":"show_dialog","text":"A fallen tree is not merely wood and branch; it is a silent monument to centuries. Each crack in its bark holds the memory of forgotten kings and the whispers of the earth itself."}]},{"actions":[{"type":"show_dialog","text":"When a great oak lies broken, its roots do not simply decay—they become the deep arteries of the forest, pulsing with ancient magic that binds the land together."}]},{"actions":[{"type":"show_dialog","text":"Those who study the fallen timber claim they can read the past written in the grain. The age and condition of the wood reveal the secrets of ages long gone."}]}]}]},{"id":"see_shells","on":"tile_enter","tile":{"x":28,"y":15},"actions":[{"type":"show_dialog","text":"You have arrived at a mysterious location."}]},{"id":"strange_stone_appears","on":"tile_enter","tile":{"x":2,"y":8},"once":true,"actions":[{"type":"spawn_decoration","asset_id":"rocks_6","x":2,"y":9},{"type":"show_dialog","text":"A strange-looking stone appears in the water..."}]},{"id":"storm_swell","on":"tile_enter","tile":{"x":3,"y":8},"once":true,"actions":[{"type":"set_weather","weather":"rain","intensity":0.9,"wind":90,"transition_secs":4},{"type":"show_message","text":"The wind picks up and the rain turns to a downpour...","duration":4000}]},{"id":"farmer_weather","on":"npc_interact","npc":"farmer","actions":[{"type":"show_dialog","speaker":"Hero-Farmer","text":"The skies do as I bid. What weather would you have, traveler?"},{"type":"show_choice","text":"Choose the weather:","choices":[{"label":"Clear skies","actions":[{"type":"set_weather","weather":"none","wind":0,"transition_secs":2}]},{"label":"Rain","actions":[{"type":"show_choice","text":"Wind direction?","choices":[{"label":"Left","actions":[{"type":"set_weather","weather":"rain","intensity":0.6,"wind":-100,"transition_secs":2},{"type":"show_message","text":"A gentle rain drifts in from the east...","duration":3000}]},{"label":"Right","actions":[{"type":"set_weather","weather":"rain","intensity":0.6,"wind":100,"transition_secs":2},{"type":"show_message","text":"A gentle rain drifts in from the west...","duration":3000}]},{"label":"No wind","actions":[{"type":"set_weather","weather":"rain","intensity":0.6,"wind":0,"transition_secs":2}]}]}]},{"label":"Snow","actions":[{"type":"show_choice","text":"Wind direction?","choices":[{"label":"Left","actions":[{"type":"set_weather","weather":"snow","intensity":0.8,"wind":-30,"transition_secs":2}]},{"label":"Right","actions":[{"type":"set_weather","weather":"snow","intensity":0.8,"wind":30,"transition_secs":2}]},{"label":"No wind","actions":[{"type":"set_weather","weather":"snow","intensity":0.5,"wind":0,"transition_secs":2}]}]}]},{"label":"Night","actions":[{"type":"set_lighting","lighting":{"col":[0,1,10],"a":0.9},"transition_secs":4}]},{"label":"Day","actions":[{"type":"set_lighting","lighting":"day","transition_secs":4}]},{"label":"Sunset","actions":[{"type":"set_lighting","lighting":"sunset","transition_secs":3}]},{"label":"Farewell."}]}]},{"id":"spawn_map_boy","on":"map_enter","once":true,"actions":[{"type":"spawn_npc","npc":"Hero-Boy","x":17,"y":4,"id":"lost_boy"}]},{"id":"found_4_map_pieces","on":"tile_enter","tile":{"x":24,"y":1},"once":true,"actions":[{"type":"show_dialog","text":"You discover a hidden cache tucked beneath a gnarled tree root. Inside, you find 4 tattered pieces of an old map, their edges singed and worn by time.","item":"map_fragment"},{"type":"give_item","item_id":"map_piece","qty":4}]},{"id":"boy_interaction_success","on":"npc_interact","npc":"lost_boy","condition":"has_item(map_piece, 4)","actions":[{"type":"show_dialog","speaker":"Young Pip","text":"By the heavens! You found them! Look how the parchment fragments align—the ancient script is whole once more!","item":"map_fragment"},{"type":"show_dialog","speaker":"Young Pip","text":"My father would have flayed me alive had I truly lost the charts to the King's highway. Bless you, noble traveler!"},{"type":"remove_item","item_id":"map_piece","qty":4},{"type":"set_flag","name":"boy_quest_complete"},{"type":"give_item","item_id":"Gold","qty":20},{"type":"show_message","text":"Quest Complete: Earned 20 Gold!","duration":4000}]},{"id":"boy_interaction_remind","on":"npc_interact","npc":"lost_boy","condition":"flag(lost_boy_met) && !has_item(map_piece, 4) && !flag(boy_quest_complete)","actions":[{"type":"show_dialog","speaker":"Young Pip","text":"Alas, the winds still howl through the valleys, and my map remains shattered. Prithee, kind traveler, have you found the 4 missing pieces yet?","item":"map_fragment"}]},{"id":"boy_interaction_first_time","on":"npc_interact","npc":"lost_boy","condition":"!flag(lost_boy_met) && !has_item(map_piece, 4) && !flag(boy_quest_complete)","actions":[{"type":"show_dialog","speaker":"Young Pip","text":"... Oh, gentle traveler, pray lend your ear to a foolish boy's plight!"},{"type":"show_dialog","speaker":"Young Pip","text":"A sudden, foul squall swept through the square and tore my grandfather's old charting map right from my grasp! It ripped into four scattered pieces, carried off into the wild lands."},{"type":"show_dialog","speaker":"Young Pip","text":"Without it, the merchants cannot pass the misty vale. Should you find all 4 pieces of the map on your journey, I beg of you to return them to me!","item":"map_fragment"},{"type":"set_flag","name":"lost_boy_met"}]},{"id":"boy_interaction_post_quest","on":"npc_interact","npc":"lost_boy","condition":"flag(boy_quest_complete)","actions":[{"type":"show_dialog","speaker":"Young Pip","text":"May the stars guide your path, brave hero! I shall never forget your kindness."}]}]}