    {
      "id": "bat_warning",
      "on": "tile_enter",
      "once": true,
      "tile": {"x":7,"y":9},
      "actions": [
        {"type":"show_dialog","text":"Słyszę nietoperze... Przeklęte żarłoki, jeden taki latający szczur potrafi wciągnąć tysiąc komarów w godzinę – gdybym ja miał taki apetyt na ucztach, królewski skarbiec poszedłby z torbami!"}
      ]
    },
